    {
      "name": "Register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var userName = pm.variables.replaceIn(\"{{$randomUserName}}\");\r",
              "pm.environment.set('uname',userName);\r",
              "\r",
              "\r",
              "var password = pm.variables.replaceIn(\"{{$randomPassword}}\");\r",
              "pm.environment.set('pw',password);\r",
              "\r",
              "var email = pm.variables.replaceIn(\"{{$randomEmail}}\");\r",
              "pm.environment.set('email',email);\r",
              "\r",
              "\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "var responseBody = pm.response.json();\r",
              "// Assertion\r",
              "\r",
              "pm.test(\"Check the response code 201 or not\",function(){\r",
              "    pm.expect(pm.response.code).to.eql(201);\r",
              "})\r",
              "\r",
              "pm.test(\"Check the response time 2000 or not\",function(){\r",
              "    pm.expect(pm.response.responseTime).to.below(2000);\r",
              "})\r",
              "\r",
              "pm.test(\"Check the response Size 2000 or not\",function(){\r",
              "    pm.expect(pm.response.responseSize).to.below(2000);\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"verify the response data format is json\",function(){\r",
              "    pm.response.to.have.jsonBody();\r",
              "})\r",
              "\r",
              "\r",
              "\r",
              "pm.test(\"Check the username as per the response\", function(){\r",
              "    pm.expect(pm.environment.get(\"username\")).to.eql(responseBody.uname)\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"verify the password as per the response\", function(){\r",
              "    pm.expect(pm.environment.get(\"password\")).to.eql(responseBody.pw)\r",
              "})\r",
              "\r",
              "pm.test(\"Check the email as per the response\", function(){\r",
              "    pm.expect(responseBody.email).to.be.a('string');\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"check the email format \", function(){\r",
              "    pm.expect(responseBody.email).to.include('@');\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"check the username string or not\", function(){\r",
              "    pm.expect(responseBody.username).to.be.a('string');\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"Check the username is exists or not\", function(){\r",
              "    pm.expect(responseBody).to.have.property(\"username\");\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"Check the password is exists or not\", function(){\r",
              "    pm.expect(responseBody).to.have.property(\"password\");\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"Check the email is exists or not\", function(){\r",
              "    pm.expect(responseBody).to.have.property(\"email\");\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"{{uname}}\",\r\n    \"password\": \"{{pw}}\",\r\n    \"email\": \"{{email}}\"\r\n}\r\n",
